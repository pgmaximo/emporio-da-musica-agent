# Obrigatório
OPENAI_API_KEY=sk-...

# Modelos (roteador barato + especialistas)
MODEL_ROUTER=
MODEL_SPECIALIST=

# Persistência: vazio = SQLite local (emporio.db). Em produção: Postgres (Supabase, pooler)
# DATABASE_URL=postgresql+asyncpg://user:pass@host:6543/postgres

# Relógio simulado (opcional, ISO). Vazio = relógio real em America/Campo_Grande
# EMPORIO_NOW=2026-02-19T10:30:00

# WhatsApp Cloud API (opcional; sem isso o webhook só registra log)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
